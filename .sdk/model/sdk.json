                    "id": "GET /api/catalog/v1",
                    "json": "{\"operationId\":\"searchDatasets\",\"parameters\":[{\"description\":\"Search query to filter datasets\",\"in\":\"query\",\"name\":\"q\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Filter datasets by NYC agency\",\"in\":\"query\",\"name\":\"agency\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Filter datasets by category (e.g., Business, Education, Environment)\",\"in\":\"query\",\"name\":\"category\",\"required\":false,\"schema\":{\"enum\":[\"Business\",\"Education\",\"Environment\",\"Health\",\"Transportation\",\"Public Safety\",\"Recreation\",\"Social Services\"],\"type\":\"string\"}},{\"description\":\"Number of results to return\",\"in\":\"query\",\"name\":\"limit\",\"required\":false,\"schema\":{\"default\":10,\"maximum\":100,\"minimum\":1,\"type\":\"integer\"}},{\"description\":\"Number of results to skip for pagination\",\"in\":\"query\",\"name\":\"offset\",\"required\":false,\"schema\":{\"default\":0,\"minimum\":0,\"type\":\"integer\"}},{\"description\":\"Sort order for results\",\"in\":\"query\",\"name\":\"sort\",\"required\":false,\"schema\":{\"default\":\"relevance\",\"enum\":[\"relevance\",\"newest\",\"popular\",\"alphabetical\"],\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"resultSetSize\":{\"description\":\"Total number of results matching the query\",\"type\":\"integer\"},\"results\":{\"items\":{\"properties\":{\"resource\":{\"properties\":{\"agency\":{\"description\":\"NYC agency that published the dataset\",\"type\":\"string\"},\"category\":{\"description\":\"Category classification\",\"type\":\"string\"},\"columns\":{\"description\":\"List of columns/fields in the dataset\",\"items\":{\"properties\":{\"dataTypeName\":{\"type\":\"string\"},\"description\":{\"type\":\"string\"},\"fieldName\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"createdAt\":{\"description\":\"Date and time the dataset was created\",\"format\":\"date-time\",\"type\":\"string\"},\"description\":{\"description\":\"Detailed description of the dataset\",\"type\":\"string\"},\"downloadCount\":{\"description\":\"Number of downloads for this dataset\",\"type\":\"integer\"},\"id\":{\"description\":\"Unique identifier for the dataset\",\"type\":\"string\"},\"name\":{\"description\":\"Name of the dataset\",\"type\":\"string\"},\"permalink\":{\"description\":\"Permanent link to the dataset\",\"format\":\"uri\",\"type\":\"string\"},\"type\":{\"description\":\"Type of resource (e.g., dataset, chart, map)\",\"type\":\"string\"},\"updatedAt\":{\"description\":\"Date and time the dataset was last updated\",\"format\":\"date-time\",\"type\":\"string\"},\"viewCount\":{\"description\":\"Number of views for this dataset\",\"type\":\"integer\"}},\"type\":\"object\"}},\"type\":\"object\"},\"type\":\"array\"}},\"type\":\"object\"}}},\"description\":\"Successful response with list of datasets\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request - invalid parameters\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Rate limit error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Too many requests - rate limit exceeded\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"error\":{\"description\":\"Error message\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Internal server error\"}},\"securitySource\":\"unspecified\"}",
